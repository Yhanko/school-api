// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                  String               @id @default(uuid())
  name                String
  email               String?
  phone               String?
  address             String?
  iban                String?
  status              String               @default("active") // "active", "blocked"
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  classes             Class[]
  events              Event[]
  subjects            Subject[]
  payments            Payment[]
  grades              Grade[]
  attendances         Attendance[]
  resources           Resource[]
  rooms               Room[]
  documentRequests    DocumentRequest[]
  messagesSent        Message[]            @relation("InstitutionMessages")
  regulations         Regulation[]         @relation("InstitutionRegulations")
  disciplinaryRecords DisciplinaryRecord[] @relation("InstitutionDisciplinary")
  notifications       Notification[]       @relation("InstitutionNotifications")
  subscriptions       Subscription[]
  activityLogs        ActivityLog[]        @relation("InstitutionLogs")
  platforms           Platform[]
  supportTickets      SupportTicket[]
  academicYears       AcademicYear[]
  lessonSummaries     LessonSummary[]
  lessonPlans         LessonPlan[]
  exams               Exam[]
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  code            String?          // e.g. student number, employee code
  role            Role             @default(STUDENT)
  lastLogin       DateTime?
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id])
  employeeProfile EmployeeProfile?

  classesTeaching Class[]   @relation("ClassTeachers")
  enrollments     Enrollment[]

  payments        Payment[]

  studentGrades Grade[] @relation("StudentGrades")
  teacherGrades Grade[] @relation("TeacherGrades")

  studentAttendance Attendance[] @relation("StudentAttendance")
  teacherAttendance Attendance[] @relation("TeacherAttendance")
  teacherLessonSummaries LessonSummary[] @relation("TeacherLessonSummaries")
  teacherLessonPlans LessonPlan[] @relation("TeacherLessonPlans")
  teacherExams Exam[] @relation("TeacherExams")

  documentRequests DocumentRequest[] @relation("StudentDocuments")

  messagesSent     Message[] @relation("SenderMessages")
  messagesReceived Message[] @relation("ReceiverMessages")

  // Parent-Child relationship
  children User[]  @relation("ParentChildren")
  parentId String?
  parent   User?   @relation("ParentChildren", fields: [parentId], references: [id])

  regulations     Regulation[]     @relation("RegulationAuthor")
  notifications   Notification[]   @relation("UserNotifications")
  createdTickets  SupportTicket[]  @relation("TicketCreator")
  supportMessages SupportMessage[] @relation("MessageSender")
  schedules       Schedule[]
  activityLogs    ActivityLog[]    @relation("UserLogs")
  resourcesCreated Resource[]      @relation("ResourceAuthor")

  disciplinaryRecords DisciplinaryRecord[] @relation("StudentDisciplinary")
  reportedIncidents   DisciplinaryRecord[] @relation("ReporterDisciplinary")

  userPermission UserPermission?

  classSubjects  ClassSubject[] @relation("TeacherClassSubjects")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  SECRETARY
  STUDENT
  PARENT
  ASSOCIATION_MEMBER
}

model EmployeeProfile {
  id              String  @id @default(uuid())
  phone           String?
  address         String?
  photoUrl        String?
  university      String?
  degree          String?
  educationPeriod String?
  city            String?
  cvUrl           String?
  biUrl           String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id            String @id @default(uuid())
  name          String
  period        String
  academicLevel String
  grade         String?
  course        String?
  roomName      String
  capacity      Int

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  teachers User[]    @relation("ClassTeachers")
  enrollments Enrollment[]
  
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  
  classSubjects ClassSubject[] @relation("ClassToClassSubject")

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  grades      Grade[]
  attendances Attendance[]
  schedules   Schedule[]
  resources   Resource[]
  lessonSummaries LessonSummary[]
  lessonPlans LessonPlan[]
  exams Exam[]
  events Event[] @relation("ClassEvents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id   String  @id @default(uuid())
  name String
  code String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  classSubjects ClassSubject[] @relation("SubjectToClassSubject")

  grades      Grade[]
  attendances Attendance[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]
  resources Resource[]
  lessonSummaries LessonSummary[]
  lessonPlans LessonPlan[]
  exams Exam[]
}

model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  class     Class   @relation("ClassToClassSubject", fields: [classId], references: [id], onDelete: Cascade)
  
  subjectId String
  subject   Subject @relation("SubjectToClassSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  
  teacherId String?
  teacher   User?   @relation("TeacherClassSubjects", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String
  date         DateTime
  type         String
  organizer    String
  location     String
  participants Int

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  classes Class[] @relation("ClassEvents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type          String // 'enrollment' | 'tuition' | 'activity'
  description   String?
  amount        Float
  status        String    @default("pending") // 'pending' | 'processing' | 'confirmed' | 'cancelled'
  dueDate       DateTime?
  paymentDate   DateTime?
  proofUrl      String?
  paymentMethod String? // 'multicaixa', 'transferencia', 'dinheiro'

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  term  String // 'first', 'second', 'third', 'final'
  type  String @default("PT") // 'AC', 'CPP', 'PT', 'MT'
  value Float

  teacherId String
  teacher   User   @relation("TeacherGrades", fields: [teacherId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  date   DateTime
  status String // 'present', 'absent', 'late', 'excused'

  teacherId String
  teacher   User   @relation("TeacherAttendance", fields: [teacherId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id            String  @id @default(uuid())
  name          String
  capacity      Int
  floor         String?
  academicLevel String
  grade         String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  classes   Class[]
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id String @id @default(uuid())

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  dayOfWeek Int // 0 = Sunday, 1 = Monday, etc.
  startTime String // e.g. "08:00"
  endTime   String // e.g. "09:30"

  institutionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentRequest {
  id String @id @default(uuid())

  studentId String
  student   User   @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: Cascade)

  type       String // 'certificate', 'declaration', 'transcript'
  status     String    @default("pending") // 'pending', 'ready', 'delivered', 'rejected'
  issuedDate DateTime?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content String
  read    Boolean @default(false)

  institutionId String
  institution   Institution @relation("InstitutionMessages", fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Regulation {
  id          String           @id @default(uuid())
  title       String
  description String?
  content     String?          @db.Text
  fileUrl     String?
  status      RegulationStatus @default(DRAFT)

  institutionId String
  institution   Institution @relation("InstitutionRegulations", fields: [institutionId], references: [id])

  authorId String
  author   User   @relation("RegulationAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegulationStatus {
  DRAFT
  PUBLISHED
}

model DisciplinaryRecord {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation("StudentDisciplinary", fields: [studentId], references: [id])

  type     String
  severity SeverityLevel      @default(LOW)
  status   DisciplinaryStatus @default(PENDING)

  description String   @db.Text
  date        DateTime @default(now())

  reportedById String
  reportedBy   User   @relation("ReporterDisciplinary", fields: [reportedById], references: [id])

  institutionId String
  institution   Institution @relation("InstitutionDisciplinary", fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

enum DisciplinaryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model UserPermission {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dashboard   Boolean @default(false)
  students    Boolean @default(false)
  teachers    Boolean @default(false)
  classes     Boolean @default(false)
  financial   Boolean @default(false)
  activities  Boolean @default(false)
  payments    Boolean @default(false)
  attendance  Boolean @default(false)
  discipline  Boolean @default(false)
  permissions Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String  @id @default(uuid())
  title       String
  description String
  type        String  @default("info")
  priority    String  @default("low")
  isRead      Boolean @default(false)

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  relatedStudentId String?

  institutionId String
  institution   Institution @relation("InstitutionNotifications", fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Float
  maxStudents Int? // null means unlimited
  maxTeachers Int?
  maxParents  Int?
  maxStaff    Int?
  features    String[]

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id        String    @id @default(uuid())
  status    String    @default("active") // 'active', 'inactive', 'cancelled', 'trialing'
  startDate DateTime  @default(now())
  endDate   DateTime?

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String  @id @default(uuid())
  action    String
  resource  String
  details   String? @db.Text
  ipAddress String?

  userId String?
  user   User?   @relation("UserLogs", fields: [userId], references: [id], onDelete: SetNull)

  institutionId String?
  institution   Institution? @relation("InstitutionLogs", fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Platform {
  id               String    @id @default(uuid())
  platformName     String
  platformType     String // 'mobile' | 'web' | 'desktop' | 'api'
  status           String    @default("active") // 'active' | 'inactive' | 'maintenance'
  activeUsersCount Int       @default(0)
  lastSync         DateTime?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalBroadcast {
  id        String    @id @default(uuid())
  message   String
  type      String    @default("info") // 'info', 'warning', 'critical'
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model SupportTicket {
  id          String @id @default(uuid())
  title       String
  description String @db.Text
  status      String @default("OPEN") // 'OPEN', 'IN_PROGRESS', 'CLOSED'
  priority    String @default("MEDIUM") // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("TicketCreator", fields: [createdById], references: [id])

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportMessage {
  id      String @id @default(uuid())
  message String @db.Text

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   // 'pdf', 'video', 'link', 'book'
  url         String

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ResourceAuthor", fields: [authorId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id            String   @id @default(uuid())
  year          String   // e.g. "2024/2025"
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(false)
  
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  classes       Class[]
  enrollments   Enrollment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  
  status         String       @default("active") // "active", "approved", "failed", "transferred", "dropped"
  finalGrade     Float?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, academicYearId])
}

model LessonSummary {
  id        String @id @default(uuid())
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("TeacherLessonSummaries", fields: [teacherId], references: [id])

  date      DateTime
  content   String @db.Text

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LessonPlan {
  id        String @id @default(uuid())
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("TeacherLessonPlans", fields: [teacherId], references: [id])

  date      DateTime
  duration  String
  theme     String

  generalObjective    String @db.Text
  educationalObjective String? @db.Text
  specificCognitive   String @db.Text
  specificPsychomotor String @db.Text
  specificAffective   String @db.Text

  teachingMethods     String? @db.Text
  teachingResources   String? @db.Text
  activities          String? @db.Text

  introMotivation       String @db.Text
  mediationAssimilation String @db.Text
  domainConsolidation   String @db.Text
  controlEvaluation     String @db.Text

  status              String @default("PENDING") // PENDING, APPROVED, REJECTED
  coordinatorFeedback String? @db.Text

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id           String @id @default(uuid())
  title        String
  term         String
  instructions String @db.Text
  totalScore   Float  @default(20)
  
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("TeacherExams", fields: [teacherId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  questions ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamQuestion {
  id          String @id @default(uuid())
  examId      String
  exam        Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  text        String @db.Text
  score       Float
  blankLines  Int    @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
