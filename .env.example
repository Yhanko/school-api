# ==============================================================================
# Environment Configuration Template - school-api
# Copie este arquivo para .env e preencha com seus valores reais
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=4000
# Lista de origens permitidas separadas por vírgula (sem barra no final)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://meudominio.com"

# ------------------------------------------------------------------------------
# Database (PostgreSQL) & Prisma
# ------------------------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/yhankoeduca?schema=public"

# Controle de inicialização de migrações no Docker:
# Defina como "true" para executar 'prisma migrate deploy' automaticamente ao iniciar o container
PRISMA_RUN_MIGRATIONS="false"
# Defina como "true" para executar 'prisma db push' se não utilizar migrations SQL
PRISMA_RUN_DB_PUSH="false"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET="insira-aqui-uma-chave-secreta-longa-e-segura"
ENCRYPTION_KEY="kTx-A6I0GfV_rB91vLqGgM1V4hN0k7M1L9O0R8F1lW0="

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue (Opcional se utilizar módulo Scraper)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Cloudinary (Upload e Armazenamento de Arquivos)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# Email Providers (Brevo / SMTP)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="brevo" # "brevo" ou "smtp"
BREVO_API_KEY=""
CONTACT_EMAIL_SUPORT="suporte@yhanko.com"

# Configurações de Fallback SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="suporte@yhanko.com"
SMTP_FROM_NAME="YhankoEduca"
SMTP_USE_TLS="True"

# ------------------------------------------------------------------------------
# SMS & Mensageria (Ombala & Twilio)
# ------------------------------------------------------------------------------
OMBALA_BASE_URL="https://api.useombala.ao"
OMBALA_API_TOKEN=""
OMBALA_FROM=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+17372212163"
