# ==============================================================================
# Environment Configuration Template - school-api
# Copie este arquivo para .env e preencha com seus valores reais
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=4000
# Lista de origens permitidas separadas por vírgula (sem barra no final)
ALLOWED_ORIGINS="http://ixnhhbw6pwn7kgv7g79tm8hp.169.58.124.176.sslip.io,http://qyqaiyzoysqhwyyahaq51kfc.169.58.124.176.sslip.io,http://vyulxcmft0kt8kzaufvvvhx6.169.58.124.176.sslip.io,http://nqj0ouamvs7fvgvrfipjdriv.169.58.124.176.sslip.io,http://l3wosoa6lrmdbvg5bfsniqnt.169.58.124.176.sslip.io,http://xvossiuafgzubstiqxm1excy.169.58.124.176.sslip.io,http://localhost:3000"

# ------------------------------------------------------------------------------
# Database (PostgreSQL) & Prisma
# ------------------------------------------------------------------------------ API_URL=http://26fnmsj719sn9c3j5tc31cik.169.58.124.176.sslip.io
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/yhankoeduca?schema=public"

# Controle de inicialização de migrações no Docker:
# Defina como "true" para executar 'prisma migrate deploy' automaticamente ao iniciar o container
PRISMA_RUN_MIGRATIONS="true"
# Defina como "true" para executar 'prisma db push' se não utilizar migrations SQL
PRISMA_RUN_DB_PUSH="false"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET="insira-aqui-uma-chave-secreta-longa-e-segura"
ENCRYPTION_KEY="kTx-A6I0GfV_rB91vLqGgM1V4hN0k7M1L9O0R8F1lW0="

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue (Módulo Scraper & Tarefas Assíncronas)
# ------------------------------------------------------------------------------
# 1. URL de Conexão Principal (Recomendado):
#    - No Docker Compose interno: redis://redis:6379
#    - Redis local/standalone na VPS: redis://localhost:6379
#    - Redis na VPS com senha e DB dedicado: redis://:sua_senha@IP_VPS:6379/1
#    - Redis Cloud / Upstash com TLS: rediss://default:sua_senha@host.upstash.io:6379/0
REDIS_URL="redis://redis:6379"

# 2. Configurações Granulares (utilizado caso REDIS_URL não seja preenchida):
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_USERNAME="" # Opcional: Para Redis 6+ com ACL

# 3. Isolamento Multi-Aplicações (CRÍTICO para compartilhar o mesmo Redis sem conflito):
# - REDIS_DB: Seleciona o banco lógico (0 a 15). Use um número diferente das outras aplicações.
REDIS_DB=1

# - REDIS_PREFIX: Namespace das chaves no Redis (garante que chaves/filas nunca colidam).
REDIS_PREFIX="school_api"

# - REDIS_CLIENT_NAME: Nome que identifica esta aplicação no 'CLIENT LIST' do Redis.
REDIS_CLIENT_NAME="school_api_scraper"

# - REDIS_TLS: Habilite ("true") para conexões seguras com SSL/TLS na nuvem.
REDIS_TLS="false"

# ------------------------------------------------------------------------------
# Cloudinary (Upload e Armazenamento de Arquivos)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# Email Providers (Brevo / SMTP)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="brevo" # "brevo" ou "smtp"
BREVO_API_KEY=""
CONTACT_EMAIL_SUPORT="suporte@yhanko.com"

# Configurações de Fallback SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="suporte@yhanko.com"
SMTP_FROM_NAME="YhankoEduca"
SMTP_USE_TLS="True"

# ------------------------------------------------------------------------------
# SMS & Mensageria (Ombala & Twilio)
# ------------------------------------------------------------------------------
OMBALA_BASE_URL="https://api.useombala.ao"
OMBALA_API_TOKEN=""
OMBALA_FROM=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+17372212163"
